{
  "name": "mcp-llm-gateways",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "MCP server, MCP security gateway, LLM streaming PII guardrail, and rate-limited fallback router.",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "task1:server": "tsx src/task1-mcp-server/main.ts",
    "task2:gateway": "tsx src/task2-mcp-gateway/main.ts",
    "task3:gateway": "tsx src/task3-llm-guardrail/main.ts",
    "task4:gateway": "tsx src/task4-router/main.ts",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "audit": "npm audit --omit=dev",
    "verify": "npm run typecheck && npm run lint && npm run test:coverage && npm run audit",
    "eval": "node --env-file-if-exists=.env --import tsx evals/run.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "1.5.0",
    "@modelcontextprotocol/sdk": "1.32.2",
    "pino": "10.4.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.19.2",
    "@vitest/coverage-v8": "4.1.12",
    "eslint": "10.14.0",
    "eslint-plugin-n": "18.5.0",
    "eslint-plugin-security": "4.2.1",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.1",
    "vitest": "4.1.12"
  },
  "overrides": {
    "minimatch": "11.0.4"
  }
}
